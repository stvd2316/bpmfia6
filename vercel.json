{
	"headers": [
		{
			"source": "/api/image",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		},
		{
			"source": "/api/download",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		},
		{
			"source": "/assets/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=31536000" }
			]
		},
		{
			"source": "/logobpm.webp",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=31536000" }
			]
		}
	]
}
